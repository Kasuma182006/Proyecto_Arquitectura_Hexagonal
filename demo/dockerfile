FROM maven:3.9.6-eclipse-temurin-17-alpine AS base
WORKDIR /app

COPY pom.xml .
RUN mvn dependency:go-offline -B

COPY src ./src


FROM base AS packager

RUN mvn clean package -DskipTests

RUN $JAVA_HOME/bin/jlink \
    --add-modules java.base,java.logging,java.xml,java.desktop,java.management,java.naming,java.sql,java.transaction.xa,java.instrument,java.security.jgss,java.security.sasl,java.net.http,java.rmi,jdk.unsupported,java.compiler \
    --strip-debug \
    --no-man-pages \
    --no-header-files \
    --compress=2 \
    --output /custom-jre


FROM alpine:3.19
WORKDIR /app

RUN apk add --no-cache gcompat wget

COPY --from=packager /custom-jre /opt/jre
ENV PATH="/opt/jre/bin:$PATH"

COPY --from=packager /app/target/*.jar app.jar

ENTRYPOINT ["java", "-jar", "app.jar"]